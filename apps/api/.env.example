# API runtime environment
# NOTE: Use filenames and URLs appropriate for your deployment target.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spacezen
CLERK_SECRET_KEY=your_clerk_secret_key
GEMINI_API_KEY=your_gemini_api_key
LOG_LEVEL=info
NODE_ENV=development

# Object storage configuration
OBJECT_STORAGE_PROVIDER=local
PUBLIC_OBJECT_SEARCH_PATHS=./storage/public
PRIVATE_OBJECT_DIR=./storage/private
API_PUBLIC_URL=http://localhost:4000

# Optional S3 / R2 configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=
AWS_S3_ENDPOINT=

# Optional GCP configuration
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
