# Root environment template for the SpaceZen monorepo.
# This file shows shared defaults and examples for local development.

# API server
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spacezen
CLERK_SECRET_KEY=your_clerk_secret_key
GEMINI_API_KEY=your_gemini_api_key
LOG_LEVEL=info
NODE_ENV=development
OBJECT_STORAGE_PROVIDER=local
PUBLIC_OBJECT_SEARCH_PATHS=./storage/public
PRIVATE_OBJECT_DIR=./storage/private
API_PUBLIC_URL=http://localhost:4000

# Web client
VITE_API_BASE_URL=http://localhost:4000
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
VITE_APP_NAME=SpaceZen
VITE_ENVIRONMENT=development
VITE_BASE_PATH=/
VITE_CLERK_PROXY_URL=
